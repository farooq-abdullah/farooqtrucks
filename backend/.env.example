DJANGO_DEBUG=true
DJANGO_SECRET_KEY=replace-with-a-random-key-before-hosting
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5180,http://127.0.0.1:5180
# Used only when coordinates cannot be matched to a time zone.
LOG_UTC_OFFSET=-06:00
# Photon supports autocomplete and forward/reverse geocoding without a
# process-wide queue. Replace both URLs with your own instance for larger use.
GEOCODING_PROVIDER=photon
GEOCODING_BASE_URL=https://photon.komoot.io
LOCATION_SEARCH_BASE_URL=https://photon.komoot.io
OSRM_BASE_URL=https://router.project-osrm.org
MAP_USER_AGENT=TripLogAssessment/0.1 (add your hosted app URL or contact before public use)
